# Wyłącznie przykładowa konfiguracja lokalnego developmentu i demonstracji.
# Skopiuj do .env i ustaw własne hasło; nigdy nie używaj wzorca w produkcji.
COMPOSE_PROJECT_NAME=roomify
POSTGRES_DB=roomify_dev
POSTGRES_USER=roomify_dev
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DEV_PASSWORD
# Porty hosta są publikowane wyłącznie na 127.0.0.1.
# W sieci Compose: db:5432, api:8080, frontend:80.
POSTGRES_HOST_PORT=5432
API_PORT=5080
FRONTEND_PORT=4200
ASPNETCORE_ENVIRONMENT=Development
